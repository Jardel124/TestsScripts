local function easyTween(obj:Instance, time:number?, props:{}, callbacks:{Completed:() -> any})
	local tweenService = game:GetService('TweenService')
	local final
	
	if tonumber(time) == nil then
		final = time
	else
		final = TweenInfo.new(time or .5)
	end
	
	local tween = tweenService:Create(obj, final, props)
	tween:Play()
	if callbacks ~= nil then
		for i, v in pairs(callbacks) do
			if i == 'Completed' then
				tween.Completed:Connect(v)
			end
		end
	end
	
	return tween
end


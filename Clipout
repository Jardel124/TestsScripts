local rs = game:GetService('RunService')

local guiname = 'CoolCOSCRIPT'
local plr = game.Players.LocalPlayer

if plr.PlayerGui:FindFirstChild(guiname) then
	plr.PlayerGui:FindFirstChild(guiname):Destroy()
	warn('Reseted Old UI')
end

local gui = Instance.new('ScreenGui')
gui.Name = guiname
gui.Parent = plr.PlayerGui
gui.ResetOnSpawn = false

local side = plr.PlayerGui:FindFirstChild('LadoBar'):Clone()
side.Badges.Name = 'Template'
side.Template.Visible = false
side.Enabled = true
side.ResetOnSpawn = false
side.Parent = gui
side.Name = 'Lado'

local toggle = side.Template:Clone()
toggle.Visible = true
toggle.Parent = side
toggle.Name = 'Toggle'



do
	for _,v in pairs(side:GetChildren()) do
		if v.Name ~= 'Template' and v.ClassName ~= 'UIListLayout' then
			v:Destroy()
		end
	end

	for _, scripted in pairs(side:GetDescendants()) do
		if scripted:IsA('Script') or scripted:IsA('LocalScript') then
			scripted:Destroy()
		end
	end
end

local v0
v0 = rs.RenderStepped:Connect(function()
	if gui then
		if plr.PlayerGui:FindFirstChild('LadoBar') then
			if plr.PlayerGui:FindFirstChild('LadoBar').Enabled == false then
				toggle.Parent = side
			else
				toggle.Parent = plr.PlayerGui:FindFirstChild('LadoBar')
			end
		end
	else
		v0:Disconnect()
		v0 = nil
		warn('Disnnected UI')
	end
end)

warn('Created UI!')

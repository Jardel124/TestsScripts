local rs = game:GetService('RunService')

local guiname = 'CoolCOSCRIPT'
local plr = game.Players.LocalPlayer

if plr.PlayerGui:FindFirstChild(guiname) then
	plr.PlayerGui:FindFirstChild(guiname):Destroy()
	warn('Reseted Old UI')
end

local gui = Instance.new('ScreenGui')
gui.Name = guiname
gui.Parent = plr.PlayerGui
gui.ResetOnSpawn = false

local side = plr.PlayerGui:FindFirstChild('LadoBar'):Clone()
side.Badges.Name = 'Template'
side.Template.Visible = false
side.Enabled = true
side.ResetOnSpawn = false
side.Parent = gui
side.Name = 'Lado'

do
	for _,v in pairs(side:GetChildren()) do
		if v.Name ~= 'Template' and v.ClassName ~= 'UIListLayout' then
			v:Destroy()
		end
	end

	for _, scripted in pairs(side:GetDescendants()) do
		if scripted:IsA('Script') or scripted:IsA('LocalScript') then
			scripted:Destroy()
		end
	end
end

local toggle = side.Template:Clone()
toggle.Visible = true
toggle.Parent = nil
toggle.Name = 'Toggle'

local function easyTween(ins:Instance, tf:TweenInfo | number, props:{})
	if typeof(tf) == 'number' then
		tf = TweenInfo.new(tf)
	end
	local tween = game:GetService('TweenService'):Create(ins, tf, props)
	tween:Play()
	return tween
end

local function createHoverVisual(button, maxscale)
	if maxscale == nil then
		maxscale = 1.1
	end
	
	local uiscale = Instance.new('UIScale')
	uiscale.Scale = 1
	uiscale.Parent = button
	button.MouseEnter:Connect(function()
		easyTween(uiscale, 0.1, {Scale = maxscale})
	end)
	button.MouseLeave:Connect(function()
		easyTween(uiscale, 0.1, {Scale = 1})
	end)
end

local function playSound(sound:Sound)
	local sound = sound:Clone()
	sound.Parent = plr.PlayerGui
	sound.Name = game:GetService('HttpService'):GenerateGUID()
	sound.Volume = 1
	sound:Play()
	sound.Ended:Connect(function()
		sound:Destroy()
	end)
end

createHoverVisual(toggle)
toggle.MouseEnter:Connect(function()
	playSound(game.SoundService.Ui.MouseEnter)
end)
toggle.MouseButton1Click:Connect(function()
	playSound(game.SoundService.Ui.Click)
	
end)
toggle.MouseLeave:Connect(function()
	playSound(game.SoundService.Ui.Leave)
end)

local v0
v0 = rs.RenderStepped:Connect(function()
	if gui then
		local hum = plr.Character and plr.Character:FindFirstChild('Humanoid')
		if hum and hum.Health <= 0 then
			toggle.Parent = plr
			return
		end
		
		if plr.PlayerGui:FindFirstChild('LadoBar') then
			if plr.PlayerGui:FindFirstChild('LadoBar').Enabled == false then
				toggle.Parent = side
			else
				toggle.Parent = plr.PlayerGui:FindFirstChild('LadoBar')
			end
		else
			toggle.Parent = plr
			warn('No LadoBar')
		end
	else
		v0:Disconnect()
		v0 = nil
		warn('Disnnected UI')
	end
end)

warn('Created UI!')
